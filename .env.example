# Настройки голосового помощника. Скопируйте файл в .env и укажите свой ключ.
# Ключ остаётся только в локальном .env и никогда не добавляется в Git.
AI_API_KEY=
# Временный тестовый профиль: ProxyAPI + Google Gemma 3n.
AI_API_BASE_URL=https://openai.api.proxyapi.ru/v1
AI_MODEL=google/gemma-3n-e4b-it
# Gemma запускается в проверяемом JSON-режиме без native tool calling.
AI_TOOL_MODE=json
AI_TIMEOUT_MS=30000
