# Настройки голосового помощника. Скопируйте файл в .env и укажите свой ключ.
# Ключ остаётся только в локальном .env и никогда не добавляется в Git.
AI_API_KEY=
# Временный тестовый профиль: Polza AI + Google Gemma 3n.
AI_API_BASE_URL=https://polza.ai/api/v1
AI_MODEL=google/gemma-3n-e4b-it
# Модель распознавания речи для голосовых команд.
AI_TRANSCRIPTION_MODEL=openai/whisper-1
# Gemma запускается в проверяемом JSON-режиме без native tool calling.
AI_TOOL_MODE=json
AI_TIMEOUT_MS=30000
# На длинную голосовую запись даём отдельное время распознавания (в миллисекундах).
AI_TRANSCRIPTION_TIMEOUT_MS=120000
